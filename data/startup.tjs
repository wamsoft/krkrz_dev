// -*- mode:tjs2 -*-
// ======================================================================
//  krkrz デモ ギャラリー (再起動なしの統合ランチャ)
// ----------------------------------------------------------------------
//  data/ をプロジェクトとして起動すると、コア機能デモ (src/core/data) と
//  横断デモ (data/、複数プラグイン) を 1 つのプロセスに束ねてメニュー表示し、
//  選択したデモへ「再起動なし」で移動、ESC でメニューへ戻る。
//
//  仕組み: 各デモは DemoScene として分離されており (各フォルダの scene.tjs)、
//  それらを 1 つの DemoShell (hub モード) に集約する。GL デモは切替時に
//  DrawDevice を差し替え/復帰する。
//
//  操作: ↑↓ / クリックでデモ選択、Enter で起動、ESC でメニューへ戻る
//        (メニュー上で ESC を押すと終了)。各デモ固有の操作はそのデモに届く。
//
//  ※ Elements パネルを使うデモは SDL3 ビルド + KRKRZ_USE_ELEMENTS=ON が必要。
//     横断デモのプラグイン (layerExVector / layerExImage / extrans / extNagano)
//     は canLink 判定で自動的に有無を吸収する (無ければ案内表示 or 項目除外)。
// ======================================================================

// --- demolib 読み込み --------------------------------------------------
// data/ から見た demolib: デスクトップ = ../src/core/data/demolib/、
// Web 合成後 = core/demolib/。
var demolibPath = void;
{
    var cands = ["core/demolib/", "../src/core/data/demolib/", "../demolib/"];
    for (var i = 0; i < cands.count; i++) {
        if (Storages.isExistentStorage(cands[i] + "demo_common.tjs")) { demolibPath = cands[i]; break; }
    }
}
if (demolibPath === void) { System.inform("demolib が見つかりません"); System.exit(1); }
Scripts.execStorage(demolibPath + "demo_common.tjs");

// --- 横断デモ (data/) の資材検索パスを登録 -----------------------------
// これらのデモは単体起動時は自分のフォルダを project にするが、この統合
// ランチャでは project = data/ なので、サブフォルダ配下の資材を明示登録する。
Storages.addAutoPath("vector_demo/font/");
Storages.addAutoPath("transition_demo/image/");

// --- シーン読み込みヘルパ ----------------------------------------------
var scenes = [];
function tryScene(path, ctor)
{
    if (!Storages.isExistentStorage(path)) { dm(@"scene skip (not found): ${path}"); return; }
    try {
        Scripts.execStorage(path);
        scenes.add(ctor());
    } catch (e) {
        dm(@"scene load failed: ${path}: ${e.message}");
    }
}

// コアデモ (src/core/data / Web 合成後は core/)。demolib と同階層基準で解決。
var coreBase = demolibPath + "../";
tryScene(coreBase + "sysinfo/scene.tjs",      function() { return new SysInfoScene(); });
tryScene(coreBase + "text_font/scene.tjs",    function() { return new TextFontScene(); });
tryScene(coreBase + "image_ops/scene.tjs",    function() { return new ImageOpsScene(); });
tryScene(coreBase + "layer_basic/scene.tjs",  function() { return new LayerBasicScene(); });
tryScene(coreBase + "input/scene.tjs",        function() { return new InputScene(); });
tryScene(coreBase + "timer_async/scene.tjs",  function() { return new TimerAsyncScene(); });
tryScene(coreBase + "gl_canvas/scene.tjs",    function() { return new GLCanvasScene(); });
tryScene(coreBase + "gl_particles/scene.tjs", function() { return new GLParticlesScene(); });
tryScene(coreBase + "elements_gallery/scene.tjs", function() { return new ElementsGalleryScene(); });
tryScene(coreBase + "elements_flow/scene.tjs", function() { return new ElementsFlowScene(); });

// 横断デモ (data/ 直下、複数プラグイン)
tryScene("vector_demo/scene.tjs",     function() { return new VectorScene(); });
tryScene("transition_demo/scene.tjs", function() { return new TransitionScene(); });

dm(@"gallery: ${scenes.count} scene(s)");
if (scenes.count == 0) { System.inform("シーンが読み込めませんでした"); System.exit(1); }

// hub 型: メニュー ⇄ 各デモを ESC / クリックで行き来する
runDemoHub(scenes, "krkrz デモ ギャラリー");
