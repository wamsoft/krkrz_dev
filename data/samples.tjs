// ----------------------------------------------------------------------
//  サンプル定義リスト (data/startup.tjs のランチャが読み込む)
//
//  path  : サンプルフォルダ名 (data/ 直下、フォルダ = 独立プロジェクト)
//  title : 一覧に表示する名前
//  desc  : 一行説明
//  cat   : カテゴリ (省略時 "横断デモ・サンプル (data/)")
//
//  ランチャは path + "/startup.tjs" が存在するエントリだけを表示するので、
//  パッケージ構成によってサンプルが欠けていても安全に動作する。
//  ※ コア機能デモは src/core/data/samples.tjs 側で定義する (ランチャが
//     マージ読込する)。プラグイン別サンプルの自動集約分は samples_auto.tjs
//     (生成物) に分離する予定。手書きのエントリはこのファイルに追加する。
// ----------------------------------------------------------------------
[
    %[ path : "transition_demo",
       title : "トランジション デモ",
       desc : "標準 + extrans + extNagano の全トランジションを Elements UI で実行" ],
    %[ path : "vector_demo",
       title : "ベクタ描画 + 画像効果",
       desc : "layerExVector でベクタ描画し layerExImage で加工 (複数プラグイン横断)" ]
]
