// -*- mode:tjs2 -*-
// ======================================================================
//  vector_demo — layerExVector ベクタ描画 + layerExImage 画像効果 (横断)
// ----------------------------------------------------------------------
//  複数プラグインをまたぐデモ (data/ 直置き):
//    layerExVector … Layer に GdiPlus 互換のベクタ描画を追加
//                     (プリミティブ / グラデ / パス / アウトライン文字)
//    layerExImage  … 描いた結果に画像効果 (ブラー / 明度 / カラー化 / ノイズ)
//    Elements      … パラメータ操作パネル
//
//  ベクタ描画ギャラリーを描き、Elements パネルで 線幅 / 回転 / グラデ色相 /
//  画像効果 を変更する。画像効果 ON のときは描画結果を複製レイヤへコピーして
//  layerExImage で加工した結果を重ねて表示する (= ベクタ→画像効果の連携)。
//
//  操作: パネルで各パラメータ変更   R = 再描画   ESC = 終了
//
//  ※ layerExVector.dll が無い環境では案内を表示して待機する。
//     アウトライン文字はフォント (font/*.ttf) がある場合のみ表示する
//     (同梱していないので、使う場合は font/ に .ttf を置く)。
// ======================================================================

// --- demolib 読み込み --------------------------------------------------
var demolibPath = void;
{
    var cands = ["../demolib/", "../core/demolib/", "../../src/core/data/demolib/"];
    for (var i = 0; i < cands.count; i++) {
        if (Storages.isExistentStorage(cands[i] + "demo_common.tjs")) { demolibPath = cands[i]; break; }
    }
}
if (demolibPath === void) { System.inform("demolib が見つかりません"); System.exit(1); }
Scripts.execStorage(demolibPath + "demo_common.tjs");

Storages.addAutoPath("font/");

var hasVector = tryPlugin("layerExVector.dll");
var hasImage  = tryPlugin("layerExImage.dll");

// 効果メニュー (layerExImage)。なしは常時、それ以外は hasImage のときだけ有効。
var EFFECTS = [
    %[ name:"なし",       apply:function(lay) { } ],
    %[ name:"ブラー",     apply:function(lay) { lay.gaussianBlur(4.0); } ],
    %[ name:"明度+",      apply:function(lay) { lay.light(40, 30); } ],
    %[ name:"カラー化",   apply:function(lay) { lay.colorize(150, 200, 0.6); } ],
    %[ name:"ノイズ",     apply:function(lay) { lay.noise(40); } ]
];

// ----------------------------------------------------------------------
class VectorWindow extends DemoWindow
{
    var vec;          // ベクタ描画レイヤ
    var fx;           // 効果適用の複製レイヤ (効果 ON 時のみ表示)
    var font;         // GdiPlus.Font (フォントがあれば)
    var haveFont = false;

    var penWidth = 3;
    var rotation = 0.0;       // 0..1 → 0..360 度
    var gradHue = 0.0;        // 0..1
    var effectIndex = 0;

    var W = 900, H = 640;     // 描画領域
    var pendingDraw = false;

    function VectorWindow()
    {
        super.DemoWindow("vector_demo — ベクタ描画 + 画像効果", 1280, 720);

        vec = new Layer(this, stage);
        vec.setSize(W, H);
        vec.setPos(24, 20);
        vec.visible = true;
        add(vec);

        fx = new Layer(this, stage);
        fx.setSize(W, H);
        fx.setPos(24, 20);
        fx.visible = false;
        add(fx);

        if (hasVector) {
            tryLoadFont();
            redraw();
        } else {
            stage.font.height = 28;
            stage.drawText(40, 40, "layerExVector.dll が見つかりません", 0xd0a0a0, 255);
            stage.drawText(40, 80, "プラグインを exe の隣か plugin64/ に置いてください", 0x9aa4b8, 255);
            stage.update();
        }

        setInfo("パネルで 線幅/回転/グラデ色相/画像効果 を変更   R: 再描画   ESC: 終了");
        showPanelDict(panelDict());
    }

    function tryLoadFont()
    {
        // 同梱していないので、font/ に .ttf があれば使う (無ければ文字はスキップ)
        var cand = ["NotoSansJP-VF.ttf", "NotoSans.ttf", "font.ttf"];
        for (var i = 0; i < cand.count; i++) {
            if (Storages.isExistentStorage(cand[i])) {
                if (GdiPlus.loadFont(cand[i], "VecFont")) {
                    font = new GdiPlus.Font("VecFont", 26);
                    haveFont = true;
                    dm("vector font loaded: " + cand[i]);
                    return;
                }
            }
        }
        dm("vector font not found (outline text skipped)");
    }

    // --- ベクタギャラリー描画 -------------------------------------------
    function redraw()
    {
        if (!hasVector) return;
        vec.clear(0xfff4f6fa);

        // 見出し帯 (ベクタ塗り)
        var head = new GdiPlus.Appearance();
        head.addBrush(0xff223052);
        vec.drawRectangle(head, 0, 0, W, 46);

        drawPrimitives(60);
        drawGradients(200);
        drawPaths(340);
        drawTransformShowcase(340);
        drawText(520);

        vec.update();
        applyEffect();
    }

    function drawPrimitives(y)
    {
        var a = new GdiPlus.Appearance();
        a.addBrush(0x803a6bd0); a.addPen(0xff1f3f88, penWidth);
        vec.drawRectangle(a, 24, y, 150, 90);

        var b = new GdiPlus.Appearance();
        b.addBrush(0x80d04a4a); b.addPen(0xff902020, penWidth);
        vec.drawEllipse(b, 200, y, 150, 90);

        // 多角形 (五角形)
        var c = new GdiPlus.Appearance();
        c.addBrush(0x80e0a030); c.addPen(0xffa06810, penWidth);
        var cx = 440, cy = y + 45, r = 46;
        var pts = [];
        for (var i = 0; i < 5; i++) {
            var ang = -Math.PI / 2 + i * 2 * Math.PI / 5;
            pts.add([cx + r * Math.cos(ang), cy + r * Math.sin(ang)]);
        }
        vec.drawPolygon(c, pts);

        // 円弧 + 扇形
        var d = new GdiPlus.Appearance();
        d.addPen(0xff8030c0, penWidth + 1);
        vec.drawArc(d, 520, y, 90, 90, 0, 270);
        var e = new GdiPlus.Appearance();
        e.addBrush(0x8030b0a0); e.addPen(0xff207868, penWidth);
        vec.drawPie(e, 640, y, 90, 90, 30, 220);

        label("プリミティブ (drawRectangle / Ellipse / Polygon / Arc / Pie)", 24, y - 22);
    }

    function drawGradients(y)
    {
        // 線形グラデ (色相はパネルで変更)
        var col1 = hsvColor(gradHue);
        var col2 = hsvColor(fmod(gradHue + 0.4, 1.0));
        var g = new GdiPlus.Appearance();
        g.addPen(0xff444444, 1);
        g.addBrush(%[ type:GdiPlus.BrushTypeLinearGradient,
                      point1:[24, y], point2:[224, y + 100],
                      color1:col1, color2:col2 ]);
        vec.drawRectangle(g, 24, y, 200, 100);

        // 放射グラデ
        var rg = new GdiPlus.Appearance();
        rg.addPen(0xff888888, 1);
        rg.addBrush(%[ type:GdiPlus.BrushTypePathGradient,
                       centerPoint:[350, y + 50], centerColor:hsvColor(gradHue), radius:60 ]);
        vec.drawEllipse(rg, 290, y, 120, 100);

        // 二重枠
        var m = new GdiPlus.Appearance();
        m.addPen(0xffe05050, penWidth + 4);
        m.addPen(0xffffffff, penWidth);
        m.addBrush(0x30000000);
        vec.drawRectangle(m, 460, y, 150, 100);

        label("グラデーション (線形 / 放射) と多重ペン", 24, y - 22);
    }

    function drawPaths(y)
    {
        // 星型パス
        var path = new GdiPlus.Path();
        var cx = 90, cy = y + 55, ro = 50, ri = 22;
        var first = true;
        var poly = [];
        for (var i = 0; i < 10; i++) {
            var rr = (i & 1) ? ri : ro;
            var ang = -Math.PI / 2 + i * Math.PI / 5;
            poly.add([cx + rr * Math.cos(ang), cy + rr * Math.sin(ang)]);
        }
        path.drawPolygon(poly);
        var ap = new GdiPlus.Appearance();
        ap.addBrush(0x80f0c040); ap.addPen(0xffa07810, penWidth);
        vec.drawPath(ap, path);

        // 波線 (drawLines)
        var wave = [];
        for (var i = 0; i <= 40; i++) {
            var x = 170 + i * 5;
            var yy = y + 55 + Math.sin(i * 0.5) * 30;
            wave.add([x, yy]);
        }
        var aw = new GdiPlus.Appearance();
        aw.addPen(0xff3070c0, penWidth);
        vec.drawLines(aw, wave);

        label("パス (drawPath / drawLines)", 24, y - 22);
    }

    // 回転する矩形 (transform ショーケース) — 右側に配置
    function drawTransformShowcase(y)
    {
        var deg = rotation * 360;
        var cx = 780, cy = y + 55;
        var path = new GdiPlus.Path();
        var quad = [];
        var half = 48;
        var corners = [ [-half,-half],[half,-half],[half,half],[-half,half] ];
        var rad = deg * Math.PI / 180;
        var cs = Math.cos(rad), sn = Math.sin(rad);
        for (var i = 0; i < 4; i++) {
            var px = corners[i][0], py = corners[i][1];
            quad.add([cx + px * cs - py * sn, cy + px * sn + py * cs]);
        }
        path.drawPolygon(quad);
        var a = new GdiPlus.Appearance();
        a.addBrush(0x8050c070); a.addPen(0xff207040, penWidth);
        vec.drawPath(a, path);
        label("回転 " + ("%d".sprintf(deg \ 1)) + "°", 740, y - 22);
    }

    function drawText(y)
    {
        if (haveFont) {
            var a = new GdiPlus.Appearance();
            a.addBrush(0xff203050);
            vec.drawString(font, a, 24, y, "アウトライン文字 — layerExVector");
            var o = new GdiPlus.Appearance();
            o.addPen(0xffc03030, 2);   // 塗りなし・枠のみ = アウトライン
            vec.drawString(font, o, 24, y + 40, "OUTLINE ABCDEF 0123");
            label("アウトライン文字 (drawString)", 24, y - 22);
        } else {
            label("アウトライン文字: フォント未同梱 (font/ に .ttf を置くと表示)", 24, y - 22);
        }
    }

    // ラベルはエンジン標準フォントで (GdiPlus フォント非依存)
    function label(text, x, y)
    {
        vec.font.height = 16;
        vec.drawText(x, y, text, 0xff405070, 255);
    }

    // --- 画像効果 (layerExImage) ----------------------------------------
    function applyEffect()
    {
        if (effectIndex == 0 || !hasImage) { fx.visible = false; vec.visible = true; return; }
        // vec の内容を fx にコピーして効果を適用し、重ねて表示
        fx.copyRect(0, 0, vec, 0, 0, W, H);
        EFFECTS[effectIndex].apply(fx);
        fx.update();
        fx.visible = true;
        vec.visible = false;
    }

    // --- Elements パネル -------------------------------------------------
    function panelDict()
    {
        var effOpts = [];
        for (var i = 0; i < EFFECTS.count; i++) effOpts.add(EFFECTS[i].name);
        return %[
            size : [320, 320], background : [28, 30, 40, 236], locale : "ja-JP",
            align : "top_right", margin : 14,
            content : %[ type : "margin", padding : 14, child : %[ type : "vtile", children : [
                %[ type : "hspacer", width : 288 ],
                %[ type : "align_center", child : %[ type : "label", text : "ベクタ描画設定", size_scale : 1.2 ] ],
                %[ type : "vspacer", height : 10 ],
                %[ type : "labeled_row", label : "線幅", label_width : 90,
                   child : %[ type : "slider_with_range", id : "pen", min : 1, max : 12, initial : penWidth ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "labeled_row", label : "回転", label_width : 90,
                   child : %[ type : "slider", id : "rot", initial : rotation ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "labeled_row", label : "グラデ色相", label_width : 90,
                   child : %[ type : "slider", id : "hue", initial : gradHue ] ],
                %[ type : "vspacer", height : 8 ],
                %[ type : "labeled_row", label : "画像効果", label_width : 90,
                   child : %[ type : "cycle_picker", id : "fx", options : effOpts, initial : effectIndex ] ],
                %[ type : "vspacer", height : 12 ],
                %[ type : "button", id : "redraw", text : "再描画" ]
            ] ] ]
        ];
    }

    function onPanelAction(id, payload)
    {
        switch (id) {
        case "pen": penWidth = Math.floor(payload + 0.5); pendingDraw = true; break;
        case "rot": rotation = payload;                   pendingDraw = true; break;
        case "hue": gradHue = payload;                    pendingDraw = true; break;
        case "fx":  effectIndex = Math.floor(+payload);   pendingDraw = true; break;
        case "redraw": pendingDraw = true; break;
        }
    }

    // パネル操作は毎フレーム 1 回にまとめて再描画 (連続スライダで重くしない)
    function onDemoFrame(tick)
    {
        if (pendingDraw) { pendingDraw = false; redraw(); }
    }

    // demolib の -demotest 終了直前に呼ばれる (この後 demolib が @demotest:ok を出す)
    function onDemoTest()
    {
        // 効果を一つ適用した状態にして検証出力
        if (hasImage) { effectIndex = 3; redraw(); }
        dm(@"@demotest:vector_demo vector=${hasVector ? 1 : 0} image=${hasImage ? 1 : 0} font=${haveFont ? 1 : 0} effect=${effectIndex}");
    }

    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_ESCAPE: System.exit(0); break;
        case VK_R: redraw(); break;
        }
    }
}

// --- 色ヘルパ (HSV→ARGB) -----------------------------------------------
function fmod(a, b) { return a - (Math.floor(a / b) * b); }
function hsvColor(h)
{
    h = fmod(h, 1.0) * 6.0;
    var i = Math.floor(h), f = h - i;
    var v = 230, p = 40, q = (230 * (1 - f) + 40 * f) \ 1, t = (40 * (1 - f) + 230 * f) \ 1;
    var r, g, b;
    switch (i % 6) {
    case 0: r = v; g = t; b = p; break;
    case 1: r = q; g = v; b = p; break;
    case 2: r = p; g = v; b = t; break;
    case 3: r = p; g = q; b = v; break;
    case 4: r = t; g = p; b = v; break;
    default: r = v; g = p; b = q; break;
    }
    return 0xff000000 | (r << 16) | (g << 8) | b;
}

var win = new VectorWindow();
win.visible = true;
