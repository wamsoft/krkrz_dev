// -*- mode:tjs2 -*-
// ======================================================================
//  トランジション表示サンプル (Elements UI / Dialog 版)
// ----------------------------------------------------------------------
//  吉里吉里Z 標準トランジション + extrans + extNagano プラグインの
//  トランジションを、 Elements UI (組込 Dialog クラス) で「選んで・
//  パラメータを設定して・実行する」ためのデモです。
//
//  ■ 動かすには
//    - Elements Dialog は SDL3 ビルド + KRKRZ_USE_ELEMENTS=ON でのみ
//      利用可能です (WINVER ビルドでは Dialog クラスが登録されません)。
//      → プリセット x64-windows (SDL) でビルドした krkrz64.exe で実行。
//    - extrans / extNagano のトランジションを使うには extrans.dll /
//      extNagano.dll を exe と同じ場所に置いてください。無い場合は
//      自動判定 (Plugins.canLink) で該当項目をメニューから除外します
//      (標準トランジションのみで動作します)。
//    - 実行例:  krkrz64.exe path/to/src/core/data/transition_demo
//
//  ■ 使い方
//    - 左上のパネルの「種類」で トランジションを選択。
//    - 「パラメータ」の各スライダ / メニューで値を調整。
//    - 「▶ 実行」ボタン (またはキー R) でトランジション再生。
//    - 画面 A ⇔ 画面 B が選んだトランジションで切り替わります。
//    - SPACE: パネル再表示 / ESC: パネルを閉じる / ←→: 種類切替
// ======================================================================

function dm(x) { Debug.message(x); }

// 実数を JSON 妥当かつ整った文字列へ整形する。
// TJS の既定 (""+実数) は 0.0 を "+0.0" と先頭 + 付きで返し JSON 不正になる、
// かつ "5.000000000000000" と冗長。sprintf で固定小数にして回避する。
function nf(x) { return "%.3f".sprintf(x); }

// ルール画像 (rule.png) は image/ 配下に置くので自動検索パスへ登録
Storages.addAutoPath("image/");

var WIDTH  = 1280;
var HEIGHT = 720;

// ----------------------------------------------------------------------
//  トランジション定義テーブル
//   各要素: %[ group, method, title, desc, rule(ルール画像要否), params ]
//   params の各要素は P_int / P_flt / P_cho ヘルパで生成:
//     P_int(key,label,min,max,def)  … 整数スライダ (slider_with_range)
//     P_flt(key,label,min,max,def)  … 実数スライダ (slider, 0..1 を min..max へ)
//     P_cho(key,label,options,def)  … 選択メニュー (selection_menu)
//                                     options = [ %[t:表示,v:値], ... ], def=初期index
// ----------------------------------------------------------------------
function P_int(key, label, mn, mx, dv) {
    return %[ key:key, label:label+" ("+mn+"〜"+mx+")", kind:"int", min:mn, max:mx, def:dv ];
}
function P_flt(key, label, mn, mx, dv) {
    return %[ key:key, label:label+" ("+nf(mn)+"〜"+nf(mx)+")", kind:"float", min:mn, max:mx, def:dv ];
}
function P_cho(key, label, options, dv) {
    return %[ key:key, label:label, kind:"choice", options:options, def:dv ];
}
function P_time(dv) { return P_int("time", "所要時間ms", 100, 5000, dv); }

// --- 標準トランジション (エンジン内蔵、常時利用可) ---
var stdDefs = [
    %[ group:"標準", method:"crossfade", title:"[標準] crossfade", desc:"単純クロスフェード", rule:false,
       params:[ P_time(1500) ] ],
    %[ group:"標準", method:"universal", title:"[標準] universal", desc:"ルール画像による万能トランジション", rule:"rule.png",
       params:[ P_time(1500), P_int("vague","あいまいさ",1,256,64) ] ],
    %[ group:"標準", method:"scroll", title:"[標準] scroll", desc:"スクロール移動で切替", rule:false,
       params:[ P_time(1200),
                P_cho("from","方向",[%[t:"左",v:0],%[t:"上",v:1],%[t:"右",v:2],%[t:"下",v:3]],0),
                P_cho("stay","残留",[%[t:"なし",v:0],%[t:"移動先を残す",v:1],%[t:"移動元を残す",v:2]],0) ] ]
];

// --- extrans プラグイン ---
var extransDefs = [
    %[ group:"extrans", method:"wave", title:"[extrans] wave", desc:"波打ちながら切替", rule:false,
       params:[ P_time(1200), P_int("maxh","波の高さ",0,200,50), P_flt("maxomega","波の密度",0.05,1.0,0.2),
                P_cho("wavetype","波タイプ",[%[t:"両端細",v:0],%[t:"最初細",v:1],%[t:"最後細",v:2]],0) ] ],
    %[ group:"extrans", method:"mosaic", title:"[extrans] mosaic", desc:"モザイクをかけて切替", rule:false,
       params:[ P_time(1000), P_int("maxsize","最大モザイク",1,100,30) ] ],
    %[ group:"extrans", method:"turn", title:"[extrans] turn", desc:"回転しながら切替", rule:false,
       params:[ P_time(1500) ] ],
    %[ group:"extrans", method:"rotatezoom", title:"[extrans] rotatezoom", desc:"回転拡大で切替", rule:false,
       params:[ P_time(1500), P_flt("factor","拡大率",0.0,3.0,1.0), P_flt("twist","ひねり",-5.0,5.0,2.0),
                P_flt("accel","加速",-3.0,3.0,0.0) ] ],
    %[ group:"extrans", method:"rotatevanish", title:"[extrans] rotatevanish", desc:"回転しながら消える", rule:false,
       params:[ P_time(1500), P_flt("twist","ひねり",-5.0,5.0,2.0), P_flt("accel","加速",0.0,4.0,2.0) ] ],
    %[ group:"extrans", method:"rotateswap", title:"[extrans] rotateswap", desc:"回転して入れ替わる", rule:false,
       params:[ P_time(1500), P_flt("twist","ひねり",-3.0,3.0,1.0) ] ],
    %[ group:"extrans", method:"ripple", title:"[extrans] ripple", desc:"波紋を広げて切替", rule:false,
       params:[ P_time(1500),
                P_cho("rwidth","波の幅",[%[t:"16",v:16],%[t:"32",v:32],%[t:"64",v:64],%[t:"128",v:128]],3),
                P_flt("roundness","丸み",0.2,3.0,1.0), P_flt("speed","速度",1.0,15.0,6.0),
                P_int("maxdrift","最大ドリフト",1,100,24) ] ]
];

// --- extNagano プラグイン ---
var extNaganoDefs = [
    %[ group:"extNagano", method:"3duniversal", title:"[extNagano] 3duniversal", desc:"立体的な万能トランジション", rule:"rule4.png",
       params:[ P_time(1500),
                P_cho("type","色空間",[%[t:"RGB",v:"RGB"],%[t:"HSB",v:"HSB"]],0),
                P_flt("speed1","速度1(元画面)",-200,200,50), P_flt("accel1","加速度1(元画面)",-2.0,2.0,0.5),
                P_flt("speed2","速度2(先画面)",-200,200,0), P_flt("accel2","加速度2(先画面)",-2.0,2.0,0.0),
                P_int("bound1","境界1",0,127,0), P_int("bound2","境界2",0,127,0) ] ],
    %[ group:"extNagano", method:"blurfade", title:"[extNagano] blurfade", desc:"ぼかしながらフェード", rule:false,
       params:[ P_time(1200), P_flt("exponent","指数",0.2,3.0,1.0), P_int("blur1","ぼかし開始",0,64,8),
                P_int("blur2","ぼかし終了",0,64,8) ] ],
    %[ group:"extNagano", method:"scanline", title:"[extNagano] scanline", desc:"走査線状に切替", rule:false,
       params:[ P_time(800) ] ],
    %[ group:"extNagano", method:"zoomfade", title:"[extNagano] zoomfade", desc:"ズームしながらフェード", rule:false,
       params:[ P_time(1200), P_flt("zoom1","ズーム元",0.0,5.0,0.0), P_flt("zoom2","ズーム先",0.0,5.0,2.0) ] ],
    %[ group:"extNagano", method:"rgbfade", title:"[extNagano] rgbfade", desc:"RGB を時間差でフェード", rule:false,
       params:[ P_time(1200), P_int("delayR","R遅延",0,255,0), P_int("delayG","G遅延",0,255,80),
                P_int("delayB","B遅延",0,255,160) ] ],
    %[ group:"extNagano", method:"spin", title:"[extNagano] spin", desc:"渦を巻いて切替", rule:false,
       params:[ P_time(1200), P_int("type1","開始タイプ",-1,11,0), P_int("type2","終了タイプ",-1,11,0) ] ],
    %[ group:"extNagano", method:"flutter", title:"[extNagano] flutter", desc:"ひらひらと切替", rule:false,
       params:[ P_time(1500) ] ],
    %[ group:"extNagano", method:"book", title:"[extNagano] book", desc:"本をめくるように切替", rule:false,
       params:[ P_time(1500), P_cho("dir","方向",[%[t:"ランダム",v:-1],%[t:"表→裏",v:0],%[t:"裏→表",v:1]],1) ] ],
    %[ group:"extNagano", method:"imagewipe", title:"[extNagano] imagewipe", desc:"ルール画像(アルファ)でワイプ", rule:"rule5.png",
       params:[ P_time(1000), P_cho("dir","方向",[%[t:"白→黒",v:0],%[t:"黒→白",v:1]],0) ] ],
    %[ group:"extNagano", method:"honeyturn", title:"[extNagano] honeyturn", desc:"ハニカム状に回転", rule:false,
       params:[ P_time(1500), P_int("size","サイズ",8,256,64), P_int("dir","方向(テンキー)",1,9,6) ] ],
    %[ group:"extNagano", method:"multiripple", title:"[extNagano] multiripple", desc:"複数の波紋で切替", rule:false,
       params:[ P_time(5000), P_int("count","波の数",1,50,30), P_int("wavecount","波の重ね数",1,8,2),
                P_int("rwidth","波の幅",4,256,20), P_int("maxdrift","最大ドリフト",1,100,32),
                P_flt("roundness","丸み",0.2,3.0,1.0), P_flt("delaylast","最後の遅延",0.0,3.0,1.5) ] ]
    // ※ extNagano の morphing は座標配列 (before/after) 指定が必要なため
    //    スライダ UI に馴染まず、本デモでは除外しています。
];

// ----------------------------------------------------------------------
//  利用可能トランジションの組み立て (プラグイン有無を判定)
// ----------------------------------------------------------------------
function tryPlugin(dll) {
    try {
        if (Plugins.canLink(dll)) {
            Plugins.link(dll);
            dm(@"plugin linked: ${dll}");
            return true;
        }
        dm(@"plugin not found (skip): ${dll}");
    } catch (e) {
        dm(@"plugin link failed: ${dll} : ${e.message}");
    }
    return false;
}

var availDefs = [];
function addDefs(arr) { for (var i = 0; i < arr.count; i++) availDefs.add(arr[i]); }

addDefs(stdDefs);
if (tryPlugin("extrans.dll"))   addDefs(extransDefs);
if (tryPlugin("extNagano.dll")) addDefs(extNaganoDefs);
dm(@"available transitions: ${availDefs.count}");

// ----------------------------------------------------------------------
//  トランジション用ベースレイヤ (完了通知を Window へ中継)
// ----------------------------------------------------------------------
class BaseLayer extends Layer
{
    var _inTransition;
    function BaseLayer(win, parent) { super.Layer(win, parent); }
    property inTransition { getter() { return _inTransition; } }
    function beginTransition(target, param) {
        _inTransition = true;
        super.beginTransition(param.method, true, target, param);
    }
    function onTransitionCompleted() {
        _inTransition = false;
        window.onTransitionCompleted();
    }
}

// ----------------------------------------------------------------------
//  操作パネル (Elements Dialog)
// ----------------------------------------------------------------------
class TransPanel extends Dialog
{
    var win;
    function TransPanel(w) { super.Dialog(); win = w; }
    function onAction(id, payload) {
        switch (id) {
        case "trans": win.requestSelectByIndex(payload); break;   // 種類変更 (遅延再構築)
        case "run":   win.runCurrent();            break;   // 実行
        case "close": close();                     break;   // 閉じる
        default:      win.setParam(id, payload);   break;   // パラメータ更新
        }
    }
}

// ----------------------------------------------------------------------
//  メインウィンドウ
// ----------------------------------------------------------------------
class MyWindow extends Window
{
    var primaryLayer;
    var base1, base2;   // 画面 A / 画面 B (トランジション対象)
    var hud;            // 最後に実行した呼び出しを表示するオーバーレイ

    var panel;              // 操作パネル (Dialog)
    var currentIndex = 0;   // 選択中トランジションの availDefs 内 index
    var currentDef;         // 選択中トランジション定義
    var paramState;         // key -> 現在値
    var pendingSelectIndex; // onContinuous で処理する種類変更要求 (index)

    function MyWindow() {
        super.Window(...);
        this.waitVSync = true;
        this.caption = "トランジション デモ (Elements UI)";
        setInnerSize(WIDTH, HEIGHT);

        primaryLayer = new Layer(this, null);
        primaryLayer.setSize(WIDTH, HEIGHT);
        primaryLayer.fillRect(0, 0, WIDTH, HEIGHT, 0xff101014);
        add(primaryLayer);

        // 画面 A / 画面 B を用意 (フルスクリーンの不透明シーン)
        base1 = new BaseLayer(this, primaryLayer);
        base1.setSize(WIDTH, HEIGHT);
        base1.visible = true;
        add(base1);

        base2 = new BaseLayer(this, primaryLayer);
        base2.setSize(WIDTH, HEIGHT);
        add(base2);

        drawScene(base1, 0xff10305f, 0xff2f86c8, "A", "画面 A");
        drawScene(base2, 0xff5f2410, 0xffd8892f, "B", "画面 B");

        // 実行内容を表示する HUD (最前面の帯)。
        // ※ primary 直下の半透明 ltAlpha はエンジンの既知の描画問題
        //    (合成異常で白帯化) を踏むため、不透明塗りで運用する
        hud = new Layer(this, primaryLayer);
        hud.setSize(WIDTH, 64);
        hud.setPos(0, HEIGHT - 64);
        hud.type = ltAlpha;
        hud.visible = true;
        add(hud);
        updateHud("トランジションを選んで [▶ 実行] を押してください");

        System.addContinuousHandler(onContinuous);

        // 初期選択。パネル表示は DrawDevice 登録後 (最初の onContinuous) まで
        // 遅延させる。コンストラクタ時点では DrawDevice 未登録で showJson が
        // 反映されないため。
        selectByIndex(0);
        if (typeof global.Dialog == "undefined") {
            System.inform("この環境では Elements Dialog が利用できません。\n" +
                          "SDL3 ビルド + KRKRZ_USE_ELEMENTS=ON でお試しください。");
        }
    }

    var panelShown = false;

    // --- シーン描画 -----------------------------------------------------
    function drawScene(lay, ctop, cbottom, letter, title) {
        var w = lay.width, h = lay.height;
        // 縦グラデーション
        var r0 = (ctop>>16)&0xff, g0 = (ctop>>8)&0xff, b0 = ctop&0xff;
        var r1 = (cbottom>>16)&0xff, g1 = (cbottom>>8)&0xff, b1 = cbottom&0xff;
        for (var y = 0; y < h; y += 2) {
            var t = y / h;
            var r = r0 + (r1-r0)*t, g = g0 + (g1-g0)*t, b = b0 + (b1-b0)*t;
            lay.fillRect(0, y, w, 2, 0xff000000 | (r<<16) | (g<<8) | b);
        }
        // アクセントの縦帯 (トランジション中の動きを見やすく)。
        // トランジション処理中は α が無視され全不透明扱いになるため、ここで
        // 半透明色 (0x40ffffff 等) を置くと開始時に真っ白な線として現れる。
        // ベース画像は全不透明で用意するのが前提なので不透明色にする。
        for (var i = 1; i < 16; i++) {
            lay.fillRect(i*(w\16), 0, 2, h, 0xff5a5a6a);
        }
        // 大きな文字
        lay.font.face = "";
        lay.font.height = 340;
        var tw = lay.font.getTextWidth(letter);
        lay.drawText((w-tw)\2, (h-340)\2 - 20, letter, 0xffffff, 220, true, 0, 0x000000, 0, 3, 3);
        // タイトル
        lay.font.height = 46;
        lay.drawText(40, 36, title + " — トランジション対象", 0xffffff, 255, true, 0, 0x000000, 0, 2, 2);
    }

    // --- HUD ------------------------------------------------------------
    function updateHud(text) {
        hud.fillRect(0, 0, hud.width, hud.height, 0xff16181e);
        hud.font.face = "";
        hud.font.height = 26;
        hud.drawText(16, 18, text, 0xffff80, 255);
        hud.update();
    }

    // --- トランジション種類の選択 --------------------------------------
    function selectByIndex(i) {
        var n = availDefs.count;
        i = i % n; if (i < 0) i += n;
        currentIndex = i;
        currentDef   = availDefs[i];
        resetParams();
    }
    function resetParams() {
        paramState = %[];
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) {
            var p = ps[i];
            if (p.kind == "choice") paramState[p.key] = p.options[p.def].v;
            else                    paramState[p.key] = p.def;
        }
    }

    // パネルからの種類変更は onAction 内で自身を invalidate できないため遅延実行。
    // cycle_picker は値変化のたびに index を通知するので、連続操作は
    // pendingSelectIndex の上書きで自然に間引かれ、フレーム毎に一度だけ再構築する。
    function requestSelectByIndex(index) {
        // 現在と同じ index (初期表示時の通知など) は無視して無駄な再構築を防ぐ
        if (Math.floor(index) == currentIndex) return;
        pendingSelectIndex = index;
    }

    function onContinuous() {
        // DrawDevice の renderer 登録後の最初のフレームでパネルを表示
        // (登録前は showPanel が false を返すので成功するまでリトライ)
        if (!panelShown && typeof global.Dialog != "undefined") {
            if (showPanel()) panelShown = true;
        }
        if (pendingSelectIndex !== void) {
            var idx = pendingSelectIndex;
            pendingSelectIndex = void;
            selectByIndex(Math.floor(idx));
            showPanel();
        }
    }

    // --- パラメータ更新 (パネルの各ウィジェットから) -------------------
    function findParam(key) {
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) if (ps[i].key == key) return ps[i];
        return void;
    }
    function setParam(key, payload) {
        var p = findParam(key);
        if (p === void) return;
        switch (p.kind) {
        case "choice":  // payload = 選択された option の index
            paramState[key] = p.options[Math.floor(payload)].v;
            break;
        case "float":  // payload = 0..1 の位置
            paramState[key] = p.min + (p.max - p.min) * payload;
            break;
        case "int":    // payload = min..max の実値
            paramState[key] = Math.floor(payload + 0.5);
            break;
        default:
            paramState[key] = payload;
            break;
        }
    }

    // --- トランジション実行 --------------------------------------------
    function runCurrent() {
        if (currentDef === void) return;
        var opt = %[];
        opt["method"] = currentDef.method;
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) opt[ps[i].key] = paramState[ps[i].key];
        // rule はファイル名(文字列) または false。TJS2 では非数値の文字列は if で
        // 常に false になるため typeof で判定する (if(rule) だと "rule.png" が
        // false 扱いされ rule が渡らない)。
        if (typeof currentDef.rule == "String") opt["rule"] = currentDef.rule;

        if (base1.inTransition) base1.stopTransition();
        base1.beginTransition(base2, opt);

        var s = currentDef.method + " : ";
        for (var i = 0; i < ps.count; i++) {
            if (i > 0) s += ", ";
            s += ps[i].key + "=" + paramState[ps[i].key];
        }
        if (typeof currentDef.rule == "String") s += ", rule=" + currentDef.rule;
        updateHud(s);
        dm("beginTransition " + s);
    }

    // トランジション完了 → 画面 A/B を入れ替え (次回は逆方向で再生)
    function onTransitionCompleted() {
        base1 <-> base2;
    }

    // --- パネル (再)表示 ------------------------------------------------
    // showJson は DrawDevice の renderer 登録前 (起動直後の数フレーム) は false を
    // 返す。戻り値を返し、初回表示は成功するまで onContinuous でリトライする。
    function showPanel() {
        if (typeof global.Dialog == "undefined") return false;
        if (panel !== void) { invalidate panel; panel = void; }
        panel = new TransPanel(this);
        var ok = panel.showJson(buildPanelJson());
        if (!ok) { invalidate panel; panel = void; }
        return ok;
    }

    // 選択中トランジションに応じた JSON レイアウトを生成
    function buildPanelJson() {
        var titles = "";
        for (var i = 0; i < availDefs.count; i++) {
            if (i > 0) titles += ",";
            titles += "\"" + availDefs[i].title + "\"";
        }
        var rows = "";
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) {
            if (i > 0) rows += ",";
            rows += paramRowJson(ps[i]);
        }
        return
        "{\"size\":[560,960],\"background\":[30,32,42,236],\"locale\":\"ja-JP\"," +
         "\"align\":\"top_left\",\"margin\":18,\"input\":{\"arrow_focus_nav\":true}," +
         "\"content\":{\"type\":\"margin\",\"padding\":16,\"child\":{\"type\":\"vtile\",\"children\":[" +
           "{\"type\":\"hspacer\",\"width\":524}," +
           "{\"type\":\"align_center\",\"child\":{\"type\":\"label\",\"text\":\"トランジション デモ\",\"size_scale\":1.9}}," +
           "{\"type\":\"vspacer\",\"height\":8}," +
           "{\"type\":\"labeled_row\",\"label\":\"種類\",\"label_width\":80,\"child\":" +
             "{\"type\":\"framed_cycle_picker\",\"id\":\"trans\",\"initial_focus\":true,\"options\":[" + titles + "],\"initial\":" + currentIndex + "}}," +
           "{\"type\":\"vspacer\",\"height\":4}," +
           "{\"type\":\"align_left\",\"child\":{\"type\":\"label\",\"text\":\"" + currentDef.desc + "\",\"color\":[150,200,255,255]}}," +
           "{\"type\":\"vspacer\",\"height\":6}," +
           "{\"type\":\"group\",\"title\":\"パラメータ\",\"child\":{\"type\":\"margin\",\"padding\":[10,40,10,10]," +
             "\"child\":{\"type\":\"vtile\",\"children\":[" + rows + "]}}}," +
           "{\"type\":\"vspacer\",\"height\":12}," +
           "{\"type\":\"htile\",\"children\":[" +
             "{\"type\":\"hsize\",\"width\":150,\"child\":{\"type\":\"button\",\"id\":\"run\",\"text\":\"▶ 実行\"}}," +
             "{\"type\":\"hspacer\",\"width\":12}," +
             "{\"type\":\"hsize\",\"width\":120,\"child\":{\"type\":\"button\",\"id\":\"close\",\"text\":\"閉じる\"}}" +
           "]}," +
           "{\"type\":\"vspacer\",\"height\":8}," +
           "{\"type\":\"align_left\",\"child\":{\"type\":\"label\"," +
             "\"text\":\"SPACE:再表示  R:実行  ←→:種類切替  ESC:閉じる\",\"color\":[160,160,170,255]}}" +
         "]}}}";
    }

    function paramRowJson(p) {
        var head = "{\"type\":\"labeled_row\",\"label\":\"" + p.label + "\",\"label_width\":200,\"child\":";
        if (p.kind == "choice") {
            var opts = "";
            for (var i = 0; i < p.options.count; i++) {
                if (i > 0) opts += ",";
                opts += "\"" + p.options[i].t + "\"";
            }
            return head + "{\"type\":\"cycle_picker\",\"id\":\"" + p.key + "\",\"options\":[" + opts +
                   "],\"initial\":" + p.def + "}}";
        } else if (p.kind == "float") {
            var pos = (p.def - p.min) / (p.max - p.min);
            return head + "{\"type\":\"slider\",\"id\":\"" + p.key + "\",\"initial\":" + nf(pos) + "}}";
        } else { // int
            return head + "{\"type\":\"slider_with_range\",\"id\":\"" + p.key + "\",\"min\":" + p.min +
                   ",\"max\":" + p.max + ",\"initial\":" + p.def + "}}";
        }
    }

    // --- キー操作 -------------------------------------------------------
    function onKeyDown(key, shift) {
        switch (key) {
        case VK_SPACE: showPanel();                            break;
        case VK_R:     runCurrent();                           break;
        case VK_LEFT:  selectByIndex(currentIndex-1); showPanel(); break;
        case VK_RIGHT: selectByIndex(currentIndex+1); showPanel(); break;
        case VK_ESCAPE:
            if (panel !== void) { invalidate panel; panel = void; }
            break;
        }
    }
}

// ----------------------------------------------------------------------
var win = new MyWindow();
win.visible = true;
