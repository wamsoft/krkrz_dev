// -*- mode:tjs2 -*-
// ======================================================================
//  トランジション表示サンプル (Elements UI / ElementsDialog 版)
// ----------------------------------------------------------------------
//  吉里吉里Z 標準トランジション + extrans + extNagano プラグインの
//  トランジションを Elements UI で「選んで・パラメータ設定して・実行」する。
//
//  単体起動用の薄いランチャ。実体は scene.tjs の TransitionScene。
//  束ね起動 (data/ ランチャ) では scene.tjs だけを読み込む。
//
//  ■ 動かすには
//    - ElementsDialog は KRKRZ_USE_ELEMENTS=ON (既定) のビルドで利用可 (SDL3 / WINVER 両対応)。
//    - extrans / extNagano を使うには extrans.dll / extNagano.dll を exe と
//      同じ場所に置く。無い場合は canLink 判定で該当項目を自動除外する。
//  ■ 使い方
//    - パネルの「種類」で選択 → [▶ 実行] (または R キー)。
//    - ←→: 種類切替  SPACE: パネル再表示  ESC: (単体では終了)
// ======================================================================

var demolibPath = void;
{
    var cands = ["../demolib/", "../core/demolib/", "../../src/core/data/demolib/"];
    for (var i = 0; i < cands.count; i++) {
        if (Storages.isExistentStorage(cands[i] + "demo_common.tjs")) { demolibPath = cands[i]; break; }
    }
}
if (demolibPath === void) { System.inform("demolib が見つかりません"); System.exit(1); }
Scripts.execStorage(demolibPath + "demo_common.tjs");
Scripts.execStorage("scene.tjs");

runDemoShell([new TransitionScene()], "トランジション デモ (Elements UI)");
