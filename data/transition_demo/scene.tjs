class TransitionScene extends DemoScene
{
    var base1, base2;        // 画面 A / 画面 B (トランジション対象)
    var availDefs;
    var currentIndex = 0, currentDef, paramState;
    var pendingSelectIndex;
    var W = 1280, H = 720;

    function TransitionScene() { super.DemoScene(I18n.entry("transition_demo.title")); }

    // --- パラメータ定義ヘルパ ---
    function P_int(key, label, mn, mx, dv) {
        return %[ key:key, label:label+" ("+mn+"〜"+mx+")", kind:"int", min:mn, max:mx, def:dv ];
    }
    function P_flt(key, label, mn, mx, dv) {
        return %[ key:key, label:label+" ("+nf(mn)+"〜"+nf(mx)+")", kind:"float", min:mn, max:mx, def:dv ];
    }
    function P_cho(key, label, options, dv) {
        return %[ key:key, label:label, kind:"choice", options:options, def:dv ];
    }
    function P_time(dv) { return P_int("time", I18n.t("transition_demo.p.time"), 100, 5000, dv); }

    function buildDefs()
    {
        var std = [
            %[ group:"標準", method:"crossfade", title:"[" + I18n.t("transition_demo.group.std") + "] crossfade", desc:I18n.t("transition_demo.d.crossfade"), rule:false,
               params:[ P_time(1500) ] ],
            %[ group:"標準", method:"universal", title:"[" + I18n.t("transition_demo.group.std") + "] universal", desc:I18n.t("transition_demo.d.universal"), rule:"rule.png",
               params:[ P_time(1500), P_int("vague",I18n.t("transition_demo.p.vague"),1,256,64) ] ],
            %[ group:"標準", method:"scroll", title:"[" + I18n.t("transition_demo.group.std") + "] scroll", desc:I18n.t("transition_demo.d.scroll"), rule:false,
               params:[ P_time(1200),
                        P_cho("from",I18n.t("transition_demo.p.dir"),[%[t:I18n.t("transition_demo.o.left"),v:0],%[t:I18n.t("transition_demo.o.up"),v:1],%[t:I18n.t("transition_demo.o.right"),v:2],%[t:I18n.t("transition_demo.o.down"),v:3]],0),
                        P_cho("stay",I18n.t("transition_demo.p.stay"),[%[t:I18n.t("transition_demo.o.none"),v:0],%[t:I18n.t("transition_demo.o.staydst"),v:1],%[t:I18n.t("transition_demo.o.staysrc"),v:2]],0) ] ]
        ];
        var extrans = [
            %[ group:"extrans", method:"wave", title:"[extrans] wave", desc:I18n.t("transition_demo.d.wave"), rule:false,
               params:[ P_time(1200), P_int("maxh",I18n.t("transition_demo.p.maxh"),0,200,50), P_flt("maxomega",I18n.t("transition_demo.p.maxomega"),0.05,1.0,0.2),
                        P_cho("wavetype",I18n.t("transition_demo.p.wavetype"),[%[t:I18n.t("transition_demo.o.bothnarrow"),v:0],%[t:I18n.t("transition_demo.o.firstnarrow"),v:1],%[t:I18n.t("transition_demo.o.lastnarrow"),v:2]],0) ] ],
            %[ group:"extrans", method:"mosaic", title:"[extrans] mosaic", desc:I18n.t("transition_demo.d.mosaic"), rule:false,
               params:[ P_time(1000), P_int("maxsize",I18n.t("transition_demo.p.maxsize"),1,100,30) ] ],
            %[ group:"extrans", method:"turn", title:"[extrans] turn", desc:I18n.t("transition_demo.d.turn"), rule:false,
               params:[ P_time(1500) ] ],
            %[ group:"extrans", method:"rotatezoom", title:"[extrans] rotatezoom", desc:I18n.t("transition_demo.d.rotatezoom"), rule:false,
               params:[ P_time(1500), P_flt("factor",I18n.t("transition_demo.p.factor"),0.0,3.0,1.0), P_flt("twist",I18n.t("transition_demo.p.twist"),-5.0,5.0,2.0),
                        P_flt("accel",I18n.t("transition_demo.p.accel"),-3.0,3.0,0.0) ] ],
            %[ group:"extrans", method:"rotatevanish", title:"[extrans] rotatevanish", desc:I18n.t("transition_demo.d.rotatevanish"), rule:false,
               params:[ P_time(1500), P_flt("twist",I18n.t("transition_demo.p.twist"),-5.0,5.0,2.0), P_flt("accel",I18n.t("transition_demo.p.accel"),0.0,4.0,2.0) ] ],
            %[ group:"extrans", method:"rotateswap", title:"[extrans] rotateswap", desc:I18n.t("transition_demo.d.rotateswap"), rule:false,
               params:[ P_time(1500), P_flt("twist",I18n.t("transition_demo.p.twist"),-3.0,3.0,1.0) ] ],
            %[ group:"extrans", method:"ripple", title:"[extrans] ripple", desc:I18n.t("transition_demo.d.ripple"), rule:false,
               params:[ P_time(1500),
                        P_cho("rwidth",I18n.t("transition_demo.p.rwidth"),[%[t:"16",v:16],%[t:"32",v:32],%[t:"64",v:64],%[t:"128",v:128]],3),
                        P_flt("roundness",I18n.t("transition_demo.p.roundness"),0.2,3.0,1.0), P_flt("speed",I18n.t("transition_demo.p.speed"),1.0,15.0,6.0),
                        P_int("maxdrift",I18n.t("transition_demo.p.maxdrift"),1,100,24) ] ]
        ];
        var nagano = [
            %[ group:"extNagano", method:"3duniversal", title:"[extNagano] 3duniversal", desc:I18n.t("transition_demo.d.3duniversal"), rule:"rule4.png",
               params:[ P_time(1500),
                        P_cho("type",I18n.t("transition_demo.p.colorspace"),[%[t:"RGB",v:"RGB"],%[t:"HSB",v:"HSB"]],0),
                        P_flt("speed1",I18n.t("transition_demo.p.speed1"),-200,200,50), P_flt("accel1",I18n.t("transition_demo.p.accel1"),-2.0,2.0,0.5),
                        P_flt("speed2",I18n.t("transition_demo.p.speed2"),-200,200,0), P_flt("accel2",I18n.t("transition_demo.p.accel2"),-2.0,2.0,0.0),
                        P_int("bound1",I18n.t("transition_demo.p.bound1"),0,127,0), P_int("bound2",I18n.t("transition_demo.p.bound2"),0,127,0) ] ],
            %[ group:"extNagano", method:"blurfade", title:"[extNagano] blurfade", desc:I18n.t("transition_demo.d.blurfade"), rule:false,
               params:[ P_time(1200), P_flt("exponent",I18n.t("transition_demo.p.exponent"),0.2,3.0,1.0), P_int("blur1",I18n.t("transition_demo.p.blur1"),0,64,8),
                        P_int("blur2",I18n.t("transition_demo.p.blur2"),0,64,8) ] ],
            %[ group:"extNagano", method:"scanline", title:"[extNagano] scanline", desc:I18n.t("transition_demo.d.scanline"), rule:false,
               params:[ P_time(800) ] ],
            %[ group:"extNagano", method:"zoomfade", title:"[extNagano] zoomfade", desc:I18n.t("transition_demo.d.zoomfade"), rule:false,
               params:[ P_time(1200), P_flt("zoom1",I18n.t("transition_demo.p.zoom1"),0.0,5.0,0.0), P_flt("zoom2",I18n.t("transition_demo.p.zoom2"),0.0,5.0,2.0) ] ],
            %[ group:"extNagano", method:"rgbfade", title:"[extNagano] rgbfade", desc:I18n.t("transition_demo.d.rgbfade"), rule:false,
               params:[ P_time(1200), P_int("delayR",I18n.t("transition_demo.p.delayR"),0,255,0), P_int("delayG",I18n.t("transition_demo.p.delayG"),0,255,80),
                        P_int("delayB",I18n.t("transition_demo.p.delayB"),0,255,160) ] ],
            %[ group:"extNagano", method:"spin", title:"[extNagano] spin", desc:I18n.t("transition_demo.d.spin"), rule:false,
               params:[ P_time(1200), P_int("type1",I18n.t("transition_demo.p.type1"),-1,11,0), P_int("type2",I18n.t("transition_demo.p.type2"),-1,11,0) ] ],
            %[ group:"extNagano", method:"flutter", title:"[extNagano] flutter", desc:I18n.t("transition_demo.d.flutter"), rule:false,
               params:[ P_time(1500) ] ],
            %[ group:"extNagano", method:"book", title:"[extNagano] book", desc:I18n.t("transition_demo.d.book"), rule:false,
               params:[ P_time(1500), P_cho("dir",I18n.t("transition_demo.p.dir"),[%[t:I18n.t("transition_demo.o.random"),v:-1],%[t:I18n.t("transition_demo.o.fwd"),v:0],%[t:I18n.t("transition_demo.o.back"),v:1]],1) ] ],
            %[ group:"extNagano", method:"imagewipe", title:"[extNagano] imagewipe", desc:I18n.t("transition_demo.d.imagewipe"), rule:"rule5.png",
               params:[ P_time(1000), P_cho("dir",I18n.t("transition_demo.p.dir"),[%[t:I18n.t("transition_demo.o.w2b"),v:0],%[t:I18n.t("transition_demo.o.b2w"),v:1]],0) ] ],
            %[ group:"extNagano", method:"honeyturn", title:"[extNagano] honeyturn", desc:I18n.t("transition_demo.d.honeyturn"), rule:false,
               params:[ P_time(1500), P_int("size",I18n.t("transition_demo.p.size"),8,256,64), P_int("dir",I18n.t("transition_demo.p.dirkey"),1,9,6) ] ],
            %[ group:"extNagano", method:"multiripple", title:"[extNagano] multiripple", desc:I18n.t("transition_demo.d.multiripple"), rule:false,
               params:[ P_time(5000), P_int("count",I18n.t("transition_demo.p.count"),1,50,30), P_int("wavecount",I18n.t("transition_demo.p.wavecount"),1,8,2),
                        P_int("rwidth",I18n.t("transition_demo.p.rwidth"),4,256,20), P_int("maxdrift",I18n.t("transition_demo.p.maxdrift"),1,100,32),
                        P_flt("roundness",I18n.t("transition_demo.p.roundness"),0.2,3.0,1.0), P_flt("delaylast",I18n.t("transition_demo.p.delaylast"),0.0,3.0,1.5) ] ]
        ];

        availDefs = [];
        for (var i = 0; i < std.count; i++) availDefs.add(std[i]);
        if (tryPlugin("extrans.dll"))   for (var i = 0; i < extrans.count; i++) availDefs.add(extrans[i]);
        if (tryPlugin("extNagano.dll")) for (var i = 0; i < nagano.count; i++) availDefs.add(nagano[i]);
        dm(@"available transitions: ${availDefs.count}");
    }

    function create()
    {
        // ルール画像検索パス。単体起動は project=transition_demo/ なので "image/"。
        // 束ね起動 (data/ ランチャ) では launcher 側が "transition_demo/image/" を登録する。
        Storages.addAutoPath("image/");

        buildDefs();

        base1 = new TransBaseLayer(window, stage, this);
        base1.setSize(W, H); base1.visible = true; window.add(base1);
        base2 = new TransBaseLayer(window, stage, this);
        base2.setSize(W, H); window.add(base2);

        drawTScene(base1, 0xff10305f, 0xff2f86c8, "A", I18n.t("transition_demo.screenA"));
        drawTScene(base2, 0xff5f2410, 0xffd8892f, "B", I18n.t("transition_demo.screenB"));

        selectByIndex(0);
        setInfo(I18n.t("transition_demo.info"));
        showPanelJson(buildPanelJson());
    }

    // --- シーン (A/B) 描画 ---
    function drawTScene(lay, ctop, cbottom, letter, title)
    {
        var w = lay.width, h = lay.height;
        var r0 = (ctop>>16)&0xff, g0 = (ctop>>8)&0xff, b0 = ctop&0xff;
        var r1 = (cbottom>>16)&0xff, g1 = (cbottom>>8)&0xff, b1 = cbottom&0xff;
        for (var y = 0; y < h; y += 2) {
            var t = y / h;
            var r = r0 + (r1-r0)*t, g = g0 + (g1-g0)*t, b = b0 + (b1-b0)*t;
            lay.fillRect(0, y, w, 2, 0xff000000 | (r<<16) | (g<<8) | b);
        }
        // トランジション中は α が無視され全不透明扱いになるため不透明色で。
        for (var i = 1; i < 16; i++) lay.fillRect(i*(w\16), 0, 2, h, 0xff5a5a6a);
        lay.font.face = ""; lay.font.height = 340;
        var tw = lay.font.getTextWidth(letter);
        lay.drawText((w-tw)\2, (h-340)\2 - 20, letter, 0xffffff, 220, true, 0, 0x000000, 0, 3, 3);
        lay.font.height = 46;
        lay.drawText(40, 36, I18n.t("transition_demo.target", %[ title : title ]), 0xffffff, 255, true, 0, 0x000000, 0, 2, 2);
    }

    // --- 種類選択 ---
    function selectByIndex(i)
    {
        var n = availDefs.count;
        i = i % n; if (i < 0) i += n;
        currentIndex = i; currentDef = availDefs[i];
        resetParams();
    }
    function resetParams()
    {
        paramState = %[];
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) {
            var p = ps[i];
            if (p.kind == "choice") paramState[p.key] = p.options[p.def].v;
            else                    paramState[p.key] = p.def;
        }
    }
    function requestSelectByIndex(index)
    {
        if (Math.floor(index) == currentIndex) return;
        pendingSelectIndex = index;
    }

    function onDemoFrame(tick)
    {
        if (pendingSelectIndex !== void) {
            var idx = pendingSelectIndex; pendingSelectIndex = void;
            selectByIndex(Math.floor(idx));
            showPanelJson(buildPanelJson());
        }
    }

    // --- パラメータ更新 ---
    function findParam(key)
    {
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) if (ps[i].key == key) return ps[i];
        return void;
    }
    function setParam(key, payload)
    {
        var p = findParam(key);
        if (p === void) return;
        switch (p.kind) {
        case "choice": paramState[key] = p.options[Math.floor(payload)].v; break;
        case "float":  paramState[key] = p.min + (p.max - p.min) * payload; break;
        case "int":    paramState[key] = Math.floor(payload + 0.5);         break;
        default:       paramState[key] = payload;                            break;
        }
    }

    // --- 実行 ---
    function runCurrent()
    {
        if (currentDef === void) return;
        var opt = %[];
        opt["method"] = currentDef.method;
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) opt[ps[i].key] = paramState[ps[i].key];
        if (typeof currentDef.rule == "String") opt["rule"] = currentDef.rule;

        if (base1.inTransition) base1.stopTransition();
        base1.beginTransition(base2, opt);

        var s = currentDef.method + " : ";
        for (var i = 0; i < ps.count; i++) {
            if (i > 0) s += ", ";
            s += ps[i].key + "=" + paramState[ps[i].key];
        }
        if (typeof currentDef.rule == "String") s += ", rule=" + currentDef.rule;
        setInfo(s);
        dm("beginTransition " + s);
    }

    function onTransitionCompleted() { base1 <-> base2; }

    // --- パネル JSON ---
    // JSON 文字列リテラル化 (" と \ をエスケープ)
    function jsonStr(v)
    {
        var t = "" + v, out = "";
        for (var i = 0; i < t.length; i++) {
            var c = t[i];
            if (c == "\\" || c == "\"") out += "\\";
            out += c;
        }
        return "\"" + out + "\"";
    }
    function buildPanelJson()
    {
        var titles = "";
        for (var i = 0; i < availDefs.count; i++) {
            if (i > 0) titles += ",";
            titles += jsonStr(availDefs[i].title);
        }
        var rows = "";
        var ps = currentDef.params;
        for (var i = 0; i < ps.count; i++) {
            if (i > 0) rows += ",";
            rows += paramRowJson(ps[i]);
        }
        return
        "{\"background\":[30,32,42,236],\"locale\":\"" + I18n.locale + "\"," +
         "\"align\":\"top_right\",\"margin\":18," +
         "\"content\":{\"type\":\"margin\",\"padding\":16,\"child\":{\"type\":\"vtile\",\"children\":[" +
           "{\"type\":\"vsize\",\"height\":0,\"child\":{\"type\":\"hspacer\",\"width\":524}}," +
           "{\"type\":\"align_center\",\"child\":{\"type\":\"label\",\"text\":\"" + I18n.t("transition_demo.panel.title") + "\",\"size_scale\":1.9}}," +
           "{\"type\":\"vspacer\",\"height\":8}," +
           "{\"type\":\"labeled_row\",\"label\":\"" + I18n.t("transition_demo.panel.type") + "\",\"label_width\":80,\"child\":" +
             "{\"type\":\"framed_cycle_picker\",\"id\":\"trans\",\"options\":[" + titles + "],\"initial\":" + currentIndex + "}}," +
           "{\"type\":\"vspacer\",\"height\":4}," +
           "{\"type\":\"align_left\",\"child\":{\"type\":\"label\",\"text\":" + jsonStr(currentDef.desc) + ",\"color\":[150,200,255,255]}}," +
           "{\"type\":\"vspacer\",\"height\":6}," +
           "{\"type\":\"group\",\"title\":\"" + I18n.t("transition_demo.panel.params") + "\",\"child\":{\"type\":\"margin\",\"padding\":[10,40,10,10]," +
             "\"child\":{\"type\":\"vtile\",\"children\":[" + rows + "]}}}," +
           "{\"type\":\"vspacer\",\"height\":12}," +
           "{\"type\":\"htile\",\"children\":[" +
             "{\"type\":\"hsize\",\"width\":150,\"child\":{\"type\":\"button\",\"id\":\"run\",\"text\":\"" + I18n.t("transition_demo.panel.run") + "\"}}," +
             "{\"type\":\"hspacer\",\"width\":12}," +
             "{\"type\":\"hsize\",\"width\":120,\"child\":{\"type\":\"button\",\"id\":\"close\",\"text\":\"" + I18n.t("transition_demo.panel.close") + "\"}}" +
           "]}," +
           "{\"type\":\"vspacer\",\"height\":8}," +
           "{\"type\":\"align_left\",\"child\":{\"type\":\"label\"," +
             "\"text\":\"" + I18n.t("transition_demo.panel.keys") + "\",\"color\":[160,160,170,255]}}" +
         "]}}}";
    }

    function paramRowJson(p)
    {
        var head = "{\"type\":\"labeled_row\",\"label\":" + jsonStr(p.label) + ",\"label_width\":200,\"child\":";
        if (p.kind == "choice") {
            var opts = "";
            for (var i = 0; i < p.options.count; i++) {
                if (i > 0) opts += ",";
                opts += jsonStr(p.options[i].t);
            }
            return head + "{\"type\":\"cycle_picker\",\"id\":\"" + p.key + "\",\"options\":[" + opts +
                   "],\"initial\":" + p.def + "}}";
        } else if (p.kind == "float") {
            var pos = (p.def - p.min) / (p.max - p.min);
            return head + "{\"type\":\"slider\",\"id\":\"" + p.key + "\",\"initial\":" + nf(pos) + "}}";
        } else {
            return head + "{\"type\":\"slider_with_range\",\"id\":\"" + p.key + "\",\"min\":" + p.min +
                   ",\"max\":" + p.max + ",\"initial\":" + p.def + "}}";
        }
    }

    function onPanelAction(id, payload)
    {
        switch (id) {
        case "trans": requestSelectByIndex(payload); break;
        case "run":   runCurrent();                  break;
        case "close": closePanel();                  break;
        default:      setParam(id, payload);         break;
        }
    }

    function onKeyDown(key, shift)
    {
        switch (key) {
        case VK_SPACE: showPanelJson(buildPanelJson()); break;
        case VK_R:     runCurrent();                    break;
        case VK_LEFT:  selectByIndex(currentIndex-1); showPanelJson(buildPanelJson()); break;
        case VK_RIGHT: selectByIndex(currentIndex+1); showPanelJson(buildPanelJson()); break;
        }
    }

    function onDemoTest()
    {
        runCurrent();
        dm(@"@demotest:transition_demo count=${availDefs.count} method=${currentDef.method}");
    }
}
