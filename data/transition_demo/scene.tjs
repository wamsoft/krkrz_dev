// -*- mode:tjs2 -*-
// ======================================================================
//  transition_demo シーン (TransitionScene)
//  標準トランジション + extrans + extNagano を Elements パネルで選択・実行。
//  横断デモ。単体起動は startup.tjs、束ね起動は data/ ランチャ。
// ======================================================================

// トランジション完了通知をシーンへ中継するベースレイヤ
class TransBaseLayer extends Layer
{
    var _inTransition, _scene;
    function TransBaseLayer(win, parent, sc) { super.Layer(win, parent); _scene = sc; }
    property inTransition { getter() { return _inTransition; } }
    function beginTransition(target, param) {
        _inTransition = true;
        super.beginTransition(param.method, true, target, param);
    }
    function onTransitionCompleted() {
        _inTransition = false;
        if (_scene !== void) _scene.onTransitionCompleted();
    }
}

// パラメータ名・選択肢・説明も表から引く (パネル JSON は言語切替のたびに作り直される)
I18n.add(%[
