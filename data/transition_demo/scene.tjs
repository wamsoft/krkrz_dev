                                           en : "Transitions (extrans / extNagano)" ],
    "transition_demo.shell"          => %[ ja : "トランジション デモ (Elements UI)", en : "Transition demo (Elements UI)" ],
    "transition_demo.info"           => %[ ja : "パネルの「種類」で選択 → [▶ 実行]   R:実行  ←→:種類切替  SPACE:再表示",
