{
  "class": "Threepp.DirectionalLight",
  "entries": {
    "krkrthreepp:Threepp.DirectionalLight": {
      "hash": "9486bfb8fcb5",
      "ja": {
        "summary": "平行光源（太陽光のような光）",
        "description": "無限遠から平行に照射される光源です。影を落とすことができます。\n\n影を落とすには castShadow=true にし、renderer.setShadowMapEnabled(true) と、\n影を受ける側の receiveShadow=true が必要です。\n平行光源の影は正投影カメラで焼くので、シーンを覆う範囲を setShadowOrthoBounds で指定します。"
      },
      "tr": {
        "summary": "Directional light (like sunlight)",
        "description": "A light whose rays are emitted in parallel from infinitely far away. It can cast shadows.\n\nTo cast shadows, set castShadow=true, call renderer.setShadowMapEnabled(true),\nand set receiveShadow=true on the receiving objects.\nDirectional light shadows are rendered with an orthographic camera, so specify the area covering the scene with setShadowOrthoBounds."
      }
    },
    "krkrthreepp:Threepp.DirectionalLight.DirectionalLight": {
      "hash": "c91078f1e598",
      "ja": {
        "summary": "コンストラクタ",
        "params": {
          "color": "光の色 (0xRRGGBB)",
          "intensity": "光の強度"
        }
      },
      "tr": {
        "summary": "Constructor",
        "params": {
          "color": "Light color (0xRRGGBB).",
          "intensity": "Light intensity."
        }
      }
    },
