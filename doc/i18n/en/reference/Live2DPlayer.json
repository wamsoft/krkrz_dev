      },
      "tr": {
        "summary": "Player for drawing",
        "description": "Has the same interface as Live2DModel plus methods for drawing.\nRequires a Live2DDevice to create."
      }
    },
    "krkrlive2d:Live2DPlayer.Live2DPlayer": {
      "hash": "023fed380193",
      "ja": {
        "summary": "コンストラクタ",
        "params": {
          "device": "Live2DDevice インスタンス"
        }
      },
      "tr": {
        "summary": "Constructor",
        "params": {
          "device": "Live2DDevice instance"
        }
      }
    },
    "krkrlive2d:Live2DPlayer.clear": {
      "hash": "e95412471a62",
      "ja": {
