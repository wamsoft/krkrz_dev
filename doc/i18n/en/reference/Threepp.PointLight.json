    "krkrthreepp:Threepp.PointLight": {
      "hash": "d12197814f37",
      "ja": {
        "summary": "点光源",
        "description": "一点から全方向に照射される光源です。\n\n影の設定は DirectionalLight と同様です。ただし setShadowOrthoBounds は平行光源専用で、点光源では効果がありません。"
      },
      "tr": {
        "summary": "Point light",
        "description": "A light emitted from a single point in all directions.\n\nShadows are set up in the same way as for DirectionalLight. However, setShadowOrthoBounds is for directional lights only and has no effect on point lights."
      }
    },
