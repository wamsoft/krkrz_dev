      "tr": {
        "summary": "Sets the scale",
        "description": "Sets the XYZ scale components of the matrix.\nThe values are only set; no operation with the current matrix is performed.",
        "params": {
          "x": "Scale factor along the X axis.",
          "y": "Scale factor along the Y axis.",
          "z": "Scale factor along the Z axis."
        }
      }
    },
