{
  "class": "Matrix44",
  "entries": {
    "Matrix44": {
      "hash": "6c1d63a2072d",
      "ja": {
        "description": "4x4行列です。\nOpenGLのため列優先行列であることに注意してください(列優先の方が演算量的に有利です)。\nDirectXなどから見ると転置されているように感じます(シェーダのHLSLでは列優先で同じです)。"
      },
      "tr": {
        "description": "A 4x4 matrix.\nNote that it is column-major, for OpenGL (column-major is also cheaper to compute).\nCompared with DirectX and similar APIs it may look transposed (HLSL shaders are column-major too, so they match)."
      }
    },
    "Matrix44.set": {
      "hash": "ce2ab97be4fa",
      "ja": {
        "summary": "マトリックス設定",
        "params": {
          "m11": "[1][1]位置の値です。",
          "m12": "[1][2]位置の値です。",
          "m13": "[1][3]位置の値です。",
          "m14": "[1][4]位置の値です。",
          "m21": "[2][1]位置の値です。",
          "m22": "[2][2]位置の値です。",
          "m23": "[2][3]位置の値です。",
          "m24": "[2][4]位置の値です。",
          "m31": "[3][1]位置の値です。",
          "m32": "[3][2]位置の値です。",
          "m33": "[3][3]位置の値です。",
          "m34": "[3][4]位置の値です。",
          "m41": "[4][1]位置の値です。",
          "m42": "[4][2]位置の値です。",
          "m43": "[4][3]位置の値です。",
          "m44": "[4][4]位置の値です。"
        }
      },
      "tr": {
        "summary": "Sets the matrix",
        "params": {
          "m11": "Value at [1][1].",
          "m12": "Value at [1][2].",
          "m13": "Value at [1][3].",
          "m14": "Value at [1][4].",
          "m21": "Value at [2][1].",
          "m22": "Value at [2][2].",
          "m23": "Value at [2][3].",
          "m24": "Value at [2][4].",
          "m31": "Value at [3][1].",
          "m32": "Value at [3][2].",
          "m33": "Value at [3][3].",
          "m34": "Value at [3][4].",
          "m41": "Value at [4][1].",
          "m42": "Value at [4][2].",
          "m43": "Value at [4][3].",
          "m44": "Value at [4][4]."
        }
      }
    },
