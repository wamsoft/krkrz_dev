    "Matrix44.setTranslate": {
      "hash": "2589f0f8e703",
      "ja": {
        "summary": "移動量設定",
        "description": "行列のXYZ移動位置に値を設定します。\n設定のみで現在の行列との演算などは行われません。",
        "params": {
          "x": "設定するX座標値",
          "y": "設定するY座標値",
          "z": "設定するZ座標値"
        }
      },
      "tr": {
        "summary": "Sets the translation",
        "description": "Sets the XYZ translation components of the matrix.\nThe values are only set; no operation with the current matrix is performed.",
        "params": {
          "x": "X coordinate to set.",
          "y": "Y coordinate to set.",
          "z": "Z coordinate to set."
        }
      }
    },
    "Matrix44.setScale": {
