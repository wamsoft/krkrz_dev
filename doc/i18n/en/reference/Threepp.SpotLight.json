  "entries": {
    "krkrthreepp:Threepp.SpotLight": {
      "hash": "189ae304840a",
      "ja": {
        "summary": "スポットライト",
        "description": "一点から円錐状に照射される光源です。\n\n影の設定は DirectionalLight と同様です。スポットライトの影は透視カメラで焼きます (角度は angle に依存)。"
      },
      "tr": {
        "summary": "Spotlight",
        "description": "A light emitted from a single point in a cone.\n\nShadows are set up in the same way as for DirectionalLight. Spotlight shadows are rendered with a perspective camera (its angle depends on angle)."
      }
    },
