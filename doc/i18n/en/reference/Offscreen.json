{
  "class": "Offscreen",
  "entries": {
    "Offscreen": {
      "hash": "e9dd3ce9046a",
      "ja": {
        "description": "オフスクリーン。\nいわゆるレンダーターゲット。テクスチャとしても利用可能です。\n内部的に FBO, Renderbuffer, Texture が生成されます。\nレンダーターゲットとして設定しないのであれば、わざわざこのクラスを使用する必要性はありません。\nTextureクラスを使用した方がメモリ効率が良いです。"
      },
      "tr": {
        "description": "An offscreen surface.\nThis is what is usually called a render target. It can also be used as a texture.\nInternally, an FBO, a renderbuffer, and a texture are created.\nIf you do not use it as a render target, there is no need to use this class.\nThe Texture class is more memory-efficient."
      }
    },
    "Offscreen.Offscreen": {
      "hash": "62c168183983",
      "ja": {
        "summary": "オフスクリーンを生成。",
        "description": "破棄はinvalidate時に行われるので、不要になったら明示的なinvalidate推奨します。",
        "params": {
          "width": "オフスクリーン幅",
          "height": "オフスクリーン高さ"
        }
      },
      "tr": {
        "summary": "Creates an offscreen surface.",
        "description": "Resources are released on invalidate, so explicitly invalidating the object once it is no longer needed is recommended.",
        "params": {
          "width": "Offscreen width.",
          "height": "Offscreen height."
        }
      }
    },
