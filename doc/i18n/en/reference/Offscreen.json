    "Offscreen.exchangeTexture": {
      "hash": "7f0b7afb833d",
      "ja": {
        "summary": "フレームバッファに設定されているテクスチャとTextureクラスが指すテクスチャを入れ替える。",
        "description": "交換するテクスチャのサイズは合わせておかないと例外となる。\nカラーフォーマットもRGBAとする必要がある。\nレンダリング途中での入れ替えも行わない方がいいかもしれない(要確認)。\nクロスフェードなどで両方に描画する必要がない場合、以前の画像をTextureとして取り出し、新しいTextureに差し替えることでオーバーヘッドを減らせる。",
        "params": {
          "texture": "交換するTextureクラスのインスタンス。"
        }
      },
      "tr": {
        "summary": "Swaps the texture attached to the framebuffer with the texture referenced by a Texture object.",
        "description": "The textures being swapped must have the same size, or an exception is thrown.\nThe color format must also be RGBA.\nIt may be best not to swap in the middle of rendering (to be confirmed).\nWhen you do not need to draw to both, as in a crossfade, you can reduce overhead by taking out the previous image as a Texture and swapping in a new Texture.",
        "params": {
          "texture": "The Texture instance to swap with."
        }
      }
    },
