{
  "class": "Threepp.AnimationAction",
  "entries": {
    "krkrthreepp:Threepp.AnimationAction": {
      "hash": "03c50e27e6ac",
      "ja": {
        "summary": "再生中の1アニメーション (ModelAnimator.clipAction/play が返す)",
        "description": "mixer が内部所有する。ModelAnimator が生きている間有効。\nチェーンメソッドは戻り値なし(void)として公開。"
      },
      "tr": {
        "summary": "A single playing animation (returned by ModelAnimator.clipAction/play)",
        "description": "Owned internally by the mixer; valid while the ModelAnimator is alive.\nChainable methods are exposed as returning nothing (void)."
      }
    },
    "krkrthreepp:Threepp.AnimationAction.play": {
      "hash": "247eaea753d5",
      "ja": {
        "summary": "再生開始"
      },
      "tr": {
        "summary": "Starts playback"
      }
    },
    "krkrthreepp:Threepp.AnimationAction.stop": {
      "hash": "ca2f8314946d",
      "ja": {
        "summary": "停止"
      },
      "tr": {
        "summary": "Stops playback"
      }
    },
    "krkrthreepp:Threepp.AnimationAction.reset": {
      "hash": "486135dd1ea9",
      "ja": {
        "summary": "先頭へ巻き戻し"
      },
      "tr": {
        "summary": "Rewinds to the beginning"
      }
    },
