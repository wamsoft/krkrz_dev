      },
      "tr": {
        "summary": "Sets the rotation from quaternion components",
        "description": "The quaternion property returns a copy of the value, so use this to write it back (Object3D only)."
      }
    },
    "krkrthreepp:Threepp.Object3D.getWorldPosition": {
      "hash": "a3068eb8092c",
      "ja": {
        "summary": "-> Vector3 (ワールド座標)",
        "description": "getWorldPosition / getWorldQuaternion / getWorldScale は matrixWorld から算出する。\n返り値が最新であるには、直前に render するか updateMatrixWorld(true) を\n呼んでおくこと(親をたどって world 行列を確定させる必要がある)。\n立ち絵フレーミングで骨(head/hips 等)の world 座標を得るのに使う。"
      },
      "tr": {
        "summary": "-> Vector3 (world position)",
        "description": "getWorldPosition / getWorldQuaternion / getWorldScale are computed from matrixWorld.\nFor the result to be up to date, render or call updateMatrixWorld(true) just before\n(the world matrix must be resolved by walking up the parents).\nUseful for getting the world coordinates of bones (head, hips, etc.) when framing a character portrait."
      }
    },
