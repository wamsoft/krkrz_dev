    "krkrthreepp:Threepp.Object3D.position": {
      "hash": "bb3c423cff20",
      "ja": {
        "summary": "位置 (Vector3、値コピー = 実質読み取り専用)",
        "description": "注意: position/rotation/scale/quaternion の getter は「値のコピー」を返すため、\nobj.position.set(...) や obj.position.x = ... を書いても本体には反映されません。\n位置・回転・スケールを変えるには setPosition/setRotation/setScale (quaternion は setQuaternion) を使ってください。"
      },
      "tr": {
        "summary": "Position (Vector3; a copy of the value, so effectively read-only)",
        "description": "Note: the position/rotation/scale/quaternion getters return a copy of the value, so\nwriting obj.position.set(...) or obj.position.x = ... does not affect the object.\nUse setPosition/setRotation/setScale (setQuaternion for quaternion) to change the position, rotation and scale."
      }
    },
